languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem cyrl dflt;
@serif_bl = [uni043D uni043F uni043A uni0433 uni043B uni043C uni0432 uni044C uni044A uni044B uni044E uni0445 uni0456 uni04BB uni0442 uni0436 uni0493 uni0437 uni049B uni04A3 uni041D uni041F uni041A uni0413 uni0420 uni041B uni041C uni0411 uni0412 uni0410 uni0416 uni0415 uni0425 uni0428 uni042E uni0401 uni0406 uni0492 uni042B uni04BA uni0417 uni0423 uni0426 uni0429 uni049A uni04A2 uni043F.flag uni043A.short uni043A.flag uni043A.short.flag uni041A.flag uni043D.flat uni0442.ss08 uni0434.ss07 uni0456.dotless uni04A3.tail_old uni049B.alternate uni049B.context uni049B.tail_old uni049B.alternate.tail_old uni049B.context.tail_old uni0429.tail_old uni049A.tail_old uni04A2.tail_old uni0426.tail_old];
@head_tl = [uni043D uni043F uni0433 uni0442 uni0432 uni044C uni044A uni044B uni043C uni0448 uni043A uni0440 uni0431 uni044E uni0436 uni0445 uni0443 uni0438 uni0456 uni04BB uni0439 uni04D9 uni0493 uni04AF uni04B1 uni0437 uni0447 uni0446 uni0449 uni049B uni04A3 uni043F.flag uni043A.short uni043A.flag uni043A.short.flag uni043D.flat uni0442.ss08 uni0434.ss07 uni0456.dotless uni0446.tail_old uni04A3.tail_old uni0449.tail_old uni049B.alternate uni049B.context uni049B.tail_old uni049B.alternate.tail_old uni049B.context.tail_old];
@no_serif_bl = [uni0414 uni0418 uni0419 uni041E uni0421 uni0422 uni0424 uni0427 uni042A uni042C uni042D uni042F uni0430 uni0431 uni0434 uni0435 uni0451 uni0438 uni0439 uni043E uni0440 uni0441 uni0443 uni0444 uni0446 uni0447 uni0448 uni0449 uni044D uni044F uni04D8 uni04E8 uni04B0 uni04AE uni04D9 uni04E9 uni04B1 uni04AF uni0430.ss01 uni0441.ss01 uni0435.ss01 uni0451.ss01 uni0446.tail_old uni0449.tail_old];
@above_marks = [uni0308 uni0307 gravecomb acutecomb uni030B uni030C.alt uni0302 uni030C uni0306 uni030A tildecomb uni0304 uni0312];
feature ccmp { sub uni0456' @above_marks by uni0456.dotless; } ccmp;
feature ss07 { featureNames { name "Printed Cyrillic de"; }; sub uni0434 by uni0434.ss07; } ss07;
feature calt { script cyrl;
lookup calt_forms {
sub uni043F' @serif_bl by uni043F.flag;
sub uni043A' @head_tl by uni043A.short;
sub uni049B' @head_tl by uni049B.context;
} calt_forms;
# к, к.short and К get the exit foot of н (tools/ka_flag.py) before a letter with a lower-left serif; қ keeps its tail
lookup calt_feet {
sub uni043A.short' @serif_bl by uni043A.short.flag;
sub uni043A' @serif_bl by uni043A.flag;
sub uni041A' @serif_bl by uni041A.flag;
sub uni043D' @no_serif_bl by uni043D.flat;
} calt_feet;
} calt;
feature ss01 {
sub uni0430 by uni0430.ss01;
sub uni0441 by uni0441.ss01;
sub uni0435 by uni0435.ss01;
sub uni0451 by uni0451.ss01;
} ss01;
feature ss08 { featureNames { name "Alternate Cyrillic te"; }; sub uni0442 by uni0442.ss08; } ss08;
feature ss09 { featureNames { name "Previous tail style"; };
sub uni0446 by uni0446.tail_old;
sub uni04A3 by uni04A3.tail_old;
sub uni0449 by uni0449.tail_old;
sub uni049B by uni049B.tail_old;
sub uni049B.alternate by uni049B.alternate.tail_old;
sub uni049B.context by uni049B.context.tail_old;
sub uni0429 by uni0429.tail_old;
sub uni049A by uni049A.tail_old;
sub uni04A2 by uni04A2.tail_old;
sub uni0426 by uni0426.tail_old;
} ss09;
feature aalt { sub uni049B from [uni049B.alternate]; sub uni0434 from [uni0434.ss07]; } aalt;
